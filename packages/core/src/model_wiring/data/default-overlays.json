    "openai-codex": {
      "access_routes": [
        {
          "billing_kind": "subscription",
          "driver": "delegated_import",
          "id": "delegated",
          "instructions": "Reuses the sign-in the Codex CLI already holds; the SDK keeps token custody.",
          "kind": "delegated",
          "label": "Codex CLI sign-in",
          "terms_posture": "first_party_only"
        },
        {
          "billing_kind": "subscription",
          "driver": "oauth_pkce",
          "id": "subscription",
          "instructions": "Requires an OAuth client you register yourself; set metadata.oauth.client_id and the redirect URI registered against it.",
          "kind": "oauth",
          "label": "ChatGPT subscription sign-in",
          "metadata": {
            "oauth": {
              "authorization_endpoint": "https://auth.openai.com/oauth/authorize",
              "device_authorization_endpoint": "https://auth.openai.com/api/accounts/deviceauth/usercode",
              "redirect_uri": "http://localhost:1455/auth/callback",
              "scopes": [
                "openid",
                "profile",
                "email",
                "offline_access"
              ],
              "token_endpoint": "https://auth.openai.com/oauth/token"
            }
          },
          "terms_posture": "third_party_permitted"
        }
      ],
      "adapter": "openai-codex-sdk",
      "api_url": null,
      "auth_methods": [
        {
          "billing_kinds": [
            "subscription",
            "api"
          ],
          "kind": "delegated",
          "label": "Codex or ChatGPT login",
          "metadata": {
            "credential_owner": "codex-client",
            "token_export": false
          }
        }
      ],
      "env": [],
      "include_models": [
        "gpt-5.6-luna",
        "gpt-5.6-sol",
        "gpt-5.6-terra"
