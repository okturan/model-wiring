    "anthropic": {
      "api_url": "https://api.anthropic.com",
      "auth_methods": [
        {
          "billing_kinds": [
            "api"
          ],
          "env": [
            "ANTHROPIC_API_KEY"
          ],
          "kind": "api_key",
          "label": "Anthropic API key",
          "metadata": {
            "gateway": {
              "credential_header": "x-api-key",
              "credential_key": "api_key",
              "credential_scheme": "",
              "headers": {
                "anthropic-version": "2023-06-01"
              },
              "methods": [
                "POST",
                "GET"
              ],
              "paths": [
                "/v1/messages",
                "/v1/messages/count_tokens",
                "/v1/models"
              ],
              "probe_path": "/v1/models"
            },
            "terms_posture": "third_party_permitted"
          }
        },
        {
          "billing_kinds": [
            "subscription"
          ],
          "kind": "delegated",
          "label": "Claude Code sign-in",
          "metadata": {
            "instructions": "Anthropic requires its own tooling for subscription access, so this reuses an existing Claude Code sign-in rather than authenticating separately.",
            "route_id": "subscription",
            "terms_posture": "first_party_only"
          }
        }
      ],
      "extends": "anthropic"
    },
